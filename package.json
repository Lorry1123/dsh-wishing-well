{
  "name": "@local/dsh-wishing-well",
  "version": "0.3.3",
  "private": true,
  "description": "Wishing Well: a cross-session kanban board for DeepSeek Harness, with a left-navigation board page, Session-row stage labels, and a kanban tool for agents.",
  "type": "module",
  "scripts": {
    "test": "node test/host.test.mjs && node test/client.test.cjs"
  },
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": ["index.js", "board.js", "github.js", "client.js", "cordis.patch.yml", "config.example.json", "locale/*.json", "icon.svg"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-context-menu",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  },
  "engines": {
    "dsh": ">=0.2.2-rc.5 <0.3.0"
  }
}
